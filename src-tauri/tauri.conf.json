{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Reflection Viewer",
  "mainBinaryName": "Reflection Viewer",
  "version": "0.2.0",
  "identifier": "edu.duke.noma.reflectionviewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5179",
    "beforeDevCommand": "npm run dev -- --port 5179",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Reflection Viewer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "copyright": "Duke University — Nasher Museum of Art",
    "category": "Education",
    "shortDescription": "Museum artifact reflection viewer",
    "longDescription": "Stages high-resolution photogrammetry scans of museum artifacts facing a sheet of dark acrylic, so each object's reflection is laid over the artwork printed on the sheet. Objects and artworks are both added by dragging a file onto the window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}